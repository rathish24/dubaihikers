# Server-side event reads and registration writes.
# Keep these in the repository-root .env for local development and configure
# them in the deployment environment for production.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key

# Temporary registration notification delivery through Resend.
REGISTRATION_NOTIFICATION_EMAIL=you@example.com
RESEND_API_KEY=re_your-api-key
RESEND_EMAIL_FROM=Dubai Hikers <onboarding@resend.dev>

# Google Places API (New) review display. Keep the API key server-side.
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_PLACE_ID=your-google-business-place-id
GOOGLE_WRITE_REVIEW_URL=https://g.page/r/your-profile/review
